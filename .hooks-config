PARTIAL_STAGE=fail
UNCOMMITTED_PUSH=fail
MAX_FILE_SIZE=1000000
MAX_FILE_LINES=2000
MAX_COMMIT_LINES=400
MAX_COMMIT_MSG_LENGTH=72
PROTECTED_BRANCHES=main
LINK_CHECK_TIMEOUT=5
CHECK_MODE=staged
COVERAGE_DIR=coverage
COVERAGE_CONFIG_GO={"floor":80,"delta":0.05,"tag":"go","command":"make test"}
CHECK_PATHS_SKIP_FILES=["config/*.yaml","config/*.yml"]
